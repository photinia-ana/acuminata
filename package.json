{
  "name": "acuminata",
  "productName": "Acuminata",
  "version": "1.0.0",
  "description": "Desktop app with browser extension for tracking browsing history",
  "author": {
    "name": "RoyHe",
    "email": "roooyhe@163.com"
  },
  "main": "main.js",
  "scripts": {
    "start": "cross-env NODE_ENV=development concurrently -k \"npm run dev:renderer\" \"npm run dev:electron\"",
    "dev:renderer": "cd src-renderer && npm run dev",
    "dev:electron": "wait-on http://localhost:5173 && electron .",
    "build:renderer": "cd src-renderer && npm run build",
    "build:electron": "electron-builder",
    "build": "npm run build:renderer && npm run build:electron"
  },
  "dependencies": {
    "devcert": "^1.2.3",
    "mkcert": "^3.2.0",
    "selfsigned": "^5.5.0",
    "sql.js": "^1.12.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^42.0.0",
    "electron-builder": "^24.13.3",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.roooyhe.acuminata",
    "productName": "Acuminata",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "agent/**/*",
      "locales/**/*",
      "package.json",
      "src-renderer/dist/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
